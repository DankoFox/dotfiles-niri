// Environment variables for Niri session and spawned processes
environment {
    // Input method configuration (Fcitx5)
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"

    // Enable Wayland native IME support for Electron/Chromium applications (Vesktop, etc.)
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
