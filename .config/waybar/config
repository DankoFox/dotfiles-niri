{
    "layer": "top",
    "position": "overlay",
    "height": 26,
    "spacing": 0,

    // Module Layout
    "modules-left": [
        "niri/workspaces",
        "group/quick-controls",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/hardware",
        "group/media",
        "group/connectivity",
        "battery"
    ],

    // Left Groups & Modules
    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        }
    },

    "group/quick-controls": {
        "orientation": "horizontal",
        "modules": [
            "custom/power",
            "custom/wallpaper",
            "custom/nightlight"
        ]
    },

    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Power Menu (wlogout)",
        "on-click": "~/.config/wlogout/toggle-wlogout.sh"
    },

    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip": true,
        "tooltip-format": "Wallpaper\n• Left-click: Randomize wallpaper\n• Right-click: Choose wallpaper",
        "on-click": "~/.config/waybar/scripts/cycle-wallpaper.sh",
        "on-click-right": "~/.config/waybar/scripts/wallpaper-picker.sh"
    },

    "custom/nightlight": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/nightlight-status.sh",
        "on-click": "~/.config/niri/toggle-nightlight.sh",
        "signal": 8,
        "interval": 300,
        "tooltip": true
    },

    "niri/window": {
        "format": "{}",
        "max-length": 50
    },

    // Center Module
    "clock": {
        "format": "{:%a %d %b | %I:%M %p}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<span color='#fabd2f'><big><b>{:%Y %B}</b></big></span>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "first-day-of-week": 1,
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#fabd2f'><b>{}</b></span>",
                "days":     "<span color='#ebdbb2'><b>{}</b></span>",
                "weeks":    "<span color='#83a598'><b>W{}</b></span>",
                "weekdays": "<span color='#fe8019'><b>{}</b></span>",
                "today":    "<span color='#fb4934'><b><u>{}</u></b></span>"
            }
        }
    },

    // Right Groups & Modules
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "memory",
            "temperature"
        ]
    },

    "memory": {
        "format": " {}%",
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB\nClick: Open System Monitor",
        "on-click": "kitty --app-id waybar-float --title 'System Monitor' -e glances"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip-format": "CPU Temperature: {temperatureC}°C\nClick: Open System Monitor",
        "on-click": "kitty --app-id waybar-float --title 'System Monitor' -e glances"
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "on-click-right": "swayosd-client --output-volume mute-toggle"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower",
        "min-length": 6
    },

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "tray"
        ]
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "tooltip-format": "{essid} via {ifname} ({ipaddr})\nClick: Network Connections",
        "format-linked": "󰈀 (No IP)",
        "format-disconnected": "󰖪 Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "kitty --app-id waybar-float --title 'Network Connections' -e nmtui"
    },

    "tray": {
        "spacing": 10
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    }
}
